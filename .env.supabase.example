# ============================================================
# SUPABASE AUTH — Environment Variables
# Copy to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ============================================================

# --- Supabase Project ---
# Find in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# --- Service Role (SERVER ONLY — never expose to client) ---
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>

# --- Resend SMTP ---
# Sign up at: https://resend.com — free tier: 3000 emails/month
# Supabase Dashboard > Project Settings > Auth > SMTP Settings
# Host: smtp.resend.com | Port: 587 | Username: resend | Password: <API_KEY>
RESEND_API_KEY=re_<your-resend-api-key>

# --- Site URL (for email redirect links) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: https://your-domain.com
