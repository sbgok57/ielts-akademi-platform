# =============================================================================
# IELTS AKADEMİ — ORTAM DEĞİŞKENLERİ ŞABLONU (.env.example)
# =============================================================================

# Uygulama Bilgileri
NEXT_PUBLIC_APP_NAME="IELTS Akademi"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_TUTOR_NAME="Lumi"

# Veritabanı (PostgreSQL + Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ielts_akademi?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ielts_akademi?schema=public"

# Kimlik Doğrulama (Auth.js v5)
AUTH_SECRET="ornek_gizli_anahtar_en_az_32_karakter_olmali_12345678"
NEXTAUTH_URL="http://localhost:3000"

# AI Altyapısı (Lumi Mentor)
# Modlar: "mock" (geliştirme için API anahtarsız) | "openai" | "anthropic" | "google"
AI_PROVIDER="mock"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Medya & Ses Depolama (S3 / Cloudflare R2 / Supabase Storage)
STORAGE_PROVIDER="local" # "local" | "s3" | "r2"
STORAGE_BUCKET="ielts-akademi-assets"
STORAGE_REGION="auto"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
NEXT_PUBLIC_CDN_URL="/assets"

# Önbellek ve Rate Limit (Upstash Redis - Opsiyonel)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
